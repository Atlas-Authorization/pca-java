<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.atlasauth</groupId>
  <artifactId>pca-wasm-chicory</artifactId>
  <version>0</version>
  <description>In-process WebAssembly core-module host for sandboxed tools on Chicory (pure Java): instruction fuel, wall-clock deadline, memory cap, no WASI. A separate module so the core library gains no engine dependency.</description>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <!-- the PCA Java library, installed into the local Maven repository first; the core pom gains nothing -->
    <dependency><groupId>net.atlasauth</groupId><artifactId>pca-mutation</artifactId><version>0</version>
      <exclusions><exclusion><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId></exclusion></exclusions></dependency>
    <!-- pinned: the interpreter machine and its ExecutionListener hook are what the fuel meter relies on -->
    <dependency><groupId>com.dylibso.chicory</groupId><artifactId>runtime</artifactId><version>1.7.5</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.3</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
      <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
    </plugins>
  </build>
</project>
